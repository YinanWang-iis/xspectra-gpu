diff --git a/XSpectra/src/lanczos_acc.f90 b/XSpectra/src/lanczos_acc.f90
index 76ec90757..cdbd97a52 100644
--- a/XSpectra/src/lanczos_acc.f90
+++ b/XSpectra/src/lanczos_acc.f90
@@ -198,4 +198,196 @@ SUBROUTINE lanczos_uspp_acc( a, b, npw, psi, ncalcv, terminator )
   DEALLOCATE( v1, v2, u, comp )
   !
 END SUBROUTINE lanczos_uspp_acc
+!
+!------------------------------------------------------------------------------
+SUBROUTINE lanczos_uspp_acc_batch( a, b, npw, psi, ncalcv, terminator, nch )
+  !----------------------------------------------------------------------------
+  !! nch independent Lanczos chains of the same k-point (xepsilon_xyz: the x, y
+  !! and z polarizations) advanced together. h_psi and S^-1 act on all active
+  !! chains in one call (one pass over vkb for nch vectors, batched FFTs); every
+  !! chain keeps its own coefficients and convergence test exactly as in
+  !! lanczos_uspp_acc, and leaves the batch when it has converged (its columns
+  !! are swapped with the last active ones so that active columns stay first).
+  USE kinds,     ONLY: DP
+  USE wvfct,     ONLY: npwx
+  USE becmod,    ONLY: becp
+  USE constants, ONLY: rytoev
+  USE xspectra,  ONLY: xniter, xnepoint, xcheck_conv, xnitermax, &
+                       xemin, xemax, xgamma, xerror
+  USE mp_pools,  ONLY: intra_pool_comm
+  USE mp,        ONLY: mp_sum
+  USE io_global, ONLY: stdout
+  !
+  IMPLICIT NONE
+  !
+  INTEGER,     INTENT(IN)    :: nch, npw
+  REAL(dp),    INTENT(INOUT) :: a(xnitermax,nch), b(xnitermax,nch)
+  COMPLEX(dp), INTENT(INOUT) :: psi(npwx,nch)
+  INTEGER,     INTENT(INOUT) :: ncalcv(nch)
+  LOGICAL,     INTENT(IN)    :: terminator
+  !
+  LOGICAL  :: converge, recalc, lconv
+  LOGICAL  :: iconv(nch)
+  INTEGER  :: i, j, c, ch, nact, col2ch(nch), itmp
+  REAL(dp) :: error, xemin_ry, xemax_ry, xgamma_ry, ai, bim1, rb
+  COMPLEX(dp) :: t
+  REAL(dp), ALLOCATABLE :: comp(:,:)
+  COMPLEX(dp), ALLOCATABLE :: u(:,:), v1(:,:), v2(:,:)
+  REAL(dp), EXTERNAL :: xs_rdot_acc
+  EXTERNAL :: h_psi
+  !
+  ALLOCATE( v1(npwx,nch), v2(npwx,nch), u(npwx,nch), comp(xnepoint,nch) )
+  a(:,:) = 0.d0
+  b(:,:) = 0.d0
+  xemax_ry  = xemax/rytoev
+  xemin_ry  = xemin/rytoev
+  xgamma_ry = xgamma/rytoev
+  iconv(:) = .false.
+  DO c = 1, nch
+     col2ch(c) = c
+  END DO
+  nact = nch
+  !
+  CALL xs_check_gpu_support()
+  !$acc enter data copyin(becp)
+  !$acc enter data copyin(becp%k)
+  !$acc data copy(psi) create(u, v1, v2)
+  !
+  !$acc parallel loop collapse(2) present(u, v1, v2)
+  DO c = 1, nch
+     DO j = 1, npwx
+        u(j,c)  = (0.d0,0.d0)
+        v1(j,c) = (0.d0,0.d0)
+        v2(j,c) = (0.d0,0.d0)
+     END DO
+  END DO
+  !
+  ! ------------------------  1st iteration (all chains) ----------------------
+  !
+  recalc = .true.
+  CALL sm1_psi_acc( recalc, npwx, npw, nch, psi, v1 )   ! v1 = S^-1 psi
+  CALL h_psi( npwx, npw, nch, v1, u )                   ! u  = H v1
+  DO c = 1, nch
+     a(1,c) = xs_rdot_acc( npw, v1(1,c), u(1,c) )
+     CALL mp_sum( a(1,c), intra_pool_comm )
+     ai = a(1,c)
+     !$acc parallel loop present(u, psi)
+     DO j = 1, npw
+        u(j,c) = u(j,c) - ai*psi(j,c)
+     END DO
+  END DO
+  recalc = .false.
+  CALL sm1_psi_acc( recalc, npwx, npw, nch, u, v1 )     ! v1 = S^-1 u
+  DO c = 1, nch
+     b(1,c) = xs_rdot_acc( npw, u(1,c), v1(1,c) )
+     CALL mp_sum( b(1,c), intra_pool_comm )
+     b(1,c) = SQRT( b(1,c) )
+     rb = 1.d0/b(1,c)
+     !$acc parallel loop present(u, v1)
+     DO j = 1, npw
+        u(j,c)  = u(j,c)*rb
+        v1(j,c) = v1(j,c)*rb
+     END DO
+  END DO
+  !
+  ! -------------------------- Next iterations -------------------------------
+  !
+  comp(:,:) = 0.d0
+  comp(1,:) = 1.d0
+  !
+  DO i = 2, xniter
+     !
+     CALL h_psi( npwx, npw, nact, v1, v2 )              ! v2 = H v1 (active columns)
+     !
+     DO c = 1, nact
+        ch = col2ch(c)
+        a(i,ch) = xs_rdot_acc( npw, v1(1,c), v2(1,c) )
+        CALL mp_sum( a(i,ch), intra_pool_comm )
+        ai = a(i,ch)
+        bim1 = b(i-1,ch)
+        !$acc parallel loop present(v2, psi, u)
+        DO j = 1, npw
+           v2(j,c) = v2(j,c) - bim1*psi(j,c)
+           v2(j,c) = v2(j,c) - ai*u(j,c)
+        END DO
+     END DO
+     !
+     !$acc parallel loop collapse(2) present(v1)
+     DO c = 1, nact
+        DO j = 1, npwx
+           v1(j,c) = (0.d0,0.d0)
+        END DO
+     END DO
+     recalc = .false.
+     CALL sm1_psi_acc( recalc, npwx, npw, nact, v2, v1 ) ! v1 = S^-1 v2
+     !
+     DO c = 1, nact
+        ch = col2ch(c)
+        b(i,ch) = xs_rdot_acc( npw, v2(1,c), v1(1,c) )
+        CALL mp_sum( b(i,ch), intra_pool_comm )
+        b(i,ch) = SQRT( b(i,ch) )
+        rb = 1.d0/b(i,ch)
+        !$acc parallel loop present(psi, u, v1, v2)
+        DO j = 1, npwx
+           psi(j,c) = u(j,c)
+           IF (j <= npw) THEN
+              v2(j,c) = v2(j,c)*rb
+              v1(j,c) = v1(j,c)*rb
+           END IF
+           u(j,c) = v2(j,c)
+        END DO
+     END DO
+     !
+     IF (MOD(i,xcheck_conv) == 0) THEN
+        c = 1
+        DO WHILE ( c <= nact )
+           ch = col2ch(c)
+           lconv = converge(a(:,ch), b(:,ch), i, comp(:,ch), error, xemin_ry, &
+                            xemax_ry, xgamma_ry, xnepoint, xerror, terminator)
+           IF ( lconv ) THEN
+              WRITE(stdout,'(8x,a,i1,a,i6,a,f12.8)') '!   [chain ',ch,'] => CONVERGED at iter ', &
+                                                     i,' with error=',error
+              ncalcv(ch) = i
+              iconv(ch) = .true.
+              IF ( c < nact ) THEN       ! move the last active chain into column c
+                 !$acc parallel loop present(psi, u, v1, v2) private(t)
+                 DO j = 1, npwx
+                    t = psi(j,c); psi(j,c) = psi(j,nact); psi(j,nact) = t
+                    t = u(j,c);   u(j,c)   = u(j,nact);   u(j,nact)   = t
+                    t = v1(j,c);  v1(j,c)  = v1(j,nact);  v1(j,nact)  = t
+                    t = v2(j,c);  v2(j,c)  = v2(j,nact);  v2(j,nact)  = t
+                 END DO
+                 itmp = col2ch(c); col2ch(c) = col2ch(nact); col2ch(nact) = itmp
+              END IF
+              nact = nact - 1
+           ELSE
+              WRITE(stdout,'(8x,a,i1,a,i6,a,f12.8)') '|   [chain ',ch,'] Estimated error at iter ', &
+                                                     i,': ', error
+              c = c + 1
+           END IF
+        END DO
+        IF ( nact == 0 ) EXIT
+     ENDIF
+     !
+  ENDDO
+  !
+  !$acc end data
+  !$acc exit data delete(becp%k)
+  !$acc exit data delete(becp)
+  !
+  DO ch = 1, nch
+     IF (.NOT.iconv(ch)) THEN
+        WRITE(stdout,'(8x,a,i1,a,i6,a)') '!   [chain ',ch,'] XANES not converged after', i-1,&
+                                         ' iterations'
+        WRITE(stdout,'(8x,a,i6,a,l1)') '!   Estimated final error after ',&
+             i-1,'iterations: ', &
+             converge(a(:,ch),b(:,ch),i-1,comp(:,ch),error,xemin_ry,xemax_ry,&
+                      xgamma_ry,xnepoint,xerror,terminator)
+        ncalcv(ch) = i-1
+     ENDIF
+  END DO
+  !
+  DEALLOCATE( v1, v2, u, comp )
+  !
+END SUBROUTINE lanczos_uspp_acc_batch
 #endif

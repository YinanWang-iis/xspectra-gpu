+SUBROUTINE xs_pol_filename( base, c, fname )
+  !----------------------------------------------------------------------------
+  !! base 'xanes.dat' -> 'xanes_x.dat'; without an extension: 'xanes' -> 'xanes_x'
+  IMPLICIT NONE
+  CHARACTER(LEN=*), INTENT(IN)  :: base, c
+  CHARACTER(LEN=*), INTENT(OUT) :: fname
+  INTEGER :: idot, islash
+  idot   = INDEX( base, '.', BACK=.TRUE. )
+  islash = INDEX( base, '/', BACK=.TRUE. )
+  IF ( idot > islash + 1 ) THEN
+     fname = base(1:idot-1) // '_' // TRIM(c) // TRIM(base(idot:))
+  ELSE
+     fname = TRIM(base) // '_' // TRIM(c)
+  ENDIF
+END SUBROUTINE xs_pol_filename

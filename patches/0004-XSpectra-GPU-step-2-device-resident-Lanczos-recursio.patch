+!----------------------------------------------------------------------------
+MODULE xs_sm1_data
+  !--------------------------------------------------------------------------
+  ! Holds the k-point matrix BB_ = -(1 + Q B)^-1 Q (B = <beta|beta>) used by
+  ! sm1_psi (host) and sm1_psi_acc (device, GPU build). Moved here from a
+  ! SAVEd local of sm1_psi_k so that both paths share it; the arithmetic of
+  ! the host path is unchanged.
+  USE kinds, ONLY : DP
+  IMPLICIT NONE
+  COMPLEX(DP), ALLOCATABLE :: BB_(:,:)
+  INTEGER :: bb_version = 0     ! incremented each time BB_ is rebuilt
+CONTAINS
+  !--------------------------------------------------------------------------
+  SUBROUTINE sm1_build_bb_k( n, lda )
+    !------------------------------------------------------------------------
+    USE uspp,       ONLY : vkb, nkb, qq_nt
+    USE uspp_param, ONLY : upf, nh
+    USE ions_base,  ONLY : nat, ntyp => nsp, ityp
+    USE mp,         ONLY : mp_sum
+    USE mp_pools,   ONLY : intra_pool_comm
+    IMPLICIT NONE
+    INTEGER, INTENT(IN) :: n, lda
+    INTEGER :: ikb, jkb, ih, jh, na, nt, ijkb0, ii
+    COMPLEX(DP), ALLOCATABLE :: ps(:,:)
+    !
+    call errore('sm1_psi','recalculating BB_ matrix',-1)
+
+    ALLOCATE( ps( nkb, nkb ) )    
+
+    call zgemm('C','N',nkb,nkb,n,(1.d0,0.d0),vkb,lda,vkb,lda,(0.d0,0.d0),BB_(1,1),nkb)
+    !******          CALL reduce( 2 * nkb * nkb, BB_ )
+    CALL mp_sum(  BB_, intra_pool_comm ) !CG
+
+    ps(:,:) = (0.d0,0.d0)
+    ijkb0 = 0
+    do nt=1,ntyp
+       if (upf(nt)%tvanp) then
+          do na=1,nat
+             if(ityp(na).eq.nt) then
+                do ii=1,nkb
+                   do jh=1,nh(nt)
+                      jkb=ijkb0 + jh
+                      do ih=1,nh(nt)
+                         ikb = ijkb0 + ih
+                         ps(ikb,ii) = ps(ikb,ii) + BB_(jkb,ii)*qq_nt(ih,jh,nt)
+                      enddo
+                   enddo
+                enddo
+                ijkb0 = ijkb0+nh(nt)
+             endif
+          enddo
+       else
+          DO na = 1, nat
+             IF ( ityp(na) == nt ) ijkb0 = ijkb0 + nh(nt)
+          END DO
+       endif
+    enddo
+
+    do ii=1,nkb
+       ps(ii,ii) = ps(ii,ii) + (1.d0,0.d0)
+    enddo
+
+    call zinv_matrix(ps,nkb)
+    BB_(:,:) = (0.d0,0.d0)
+    ijkb0 = 0
+    do nt=1,ntyp
+       if (upf(nt)%tvanp) then
+          do na=1,nat
+             if(ityp(na).eq.nt) then
+                do ii=1,nkb
+                   do jh=1,nh(nt)
+                      jkb=ijkb0 + jh
+                      do ih=1,nh(nt)
+                         ikb = ijkb0 + ih
+                         ! BB_(ii,jkb) = BB_(ii,jkb) - ps(ii,jkb)*qq_nt(ih,jh,nt) ! this seems false
+                         BB_(ii,jkb) = BB_(ii,jkb) - ps(ii,ikb)*qq_nt(ih,jh,nt) ! modified by CG
+                      enddo
+                   enddo
+                enddo
+                ijkb0 = ijkb0+nh(nt)
+             endif
+          enddo
+       else
+          DO na = 1, nat
+             IF ( ityp(na) == nt ) ijkb0 = ijkb0 + nh(nt)
+          END DO
+       endif
+    enddo
+    deallocate(ps)
+    bb_version = bb_version + 1
+    !
+  END SUBROUTINE sm1_build_bb_k
+  !
+END MODULE xs_sm1_data
+

+#if defined(__CUDA)
+!----------------------------------------------------------------------------
+SUBROUTINE sm1_psi_acc( recalc, lda, n, m, psi, spsi )
+  !----------------------------------------------------------------------------
+  !! GPU build, k-points: spsi = S^-1 psi with psi, spsi (and vkb) resident
+  !! on the device. Same algebra as sm1_psi_k:
+  !!    spsi = psi + vkb * BB_ * (vkb^H psi)
+  !! BB_ is built on the host (sm1_build_bb_k, once per k-point) and mirrored
+  !! on the device whenever its version changes.
+  !
+  USE kinds,       ONLY : DP
+  USE uspp,        ONLY : okvan, vkb, nkb
+  USE xs_sm1_data, ONLY : BB_, bb_version, sm1_build_bb_k
+  USE mp_bands,    ONLY : intra_bgrp_comm
+  USE mp,          ONLY : mp_sum, mp_size
+  !
+  IMPLICIT NONE
+  !
+  LOGICAL     :: recalc
+  INTEGER     :: lda, n, m
+  COMPLEX(DP) :: psi(lda,m), spsi(lda,m)
+  !
+  INTEGER, SAVE :: bb_version_dev = -1   ! version of BB_ present on the device
+  COMPLEX(DP), ALLOCATABLE :: bec_d(:,:), ps_d(:,:)
+  INTEGER :: i, ibnd
+  !
+  CALL start_clock( 'sm1' )
+  !
+  !$acc parallel loop collapse(2) present(psi, spsi)
+  DO ibnd = 1, m
+     DO i = 1, lda
+        spsi(i,ibnd) = psi(i,ibnd)
+     END DO
+  END DO
+  !
+  IF ( nkb == 0 .OR. .NOT. okvan ) THEN
+     CALL stop_clock( 'sm1' )
+     RETURN
+  END IF
+  !
+  IF ( .NOT. ALLOCATED(BB_) ) THEN
+     ALLOCATE( BB_(nkb,nkb) )
+     recalc = .true.
+  END IF
+  IF ( recalc ) CALL sm1_build_bb_k( n, lda )     ! host vkb is up to date (init_us_2)
+  IF ( bb_version_dev /= bb_version ) THEN
+     IF ( bb_version_dev < 0 ) THEN
+        !$acc enter data copyin(BB_)
+     ELSE
+        !$acc update device(BB_)
+     END IF
+     bb_version_dev = bb_version
+  END IF
+  !
+  ALLOCATE( bec_d(nkb,m), ps_d(nkb,m) )
+  !$acc data present(vkb, psi, spsi, BB_) create(bec_d, ps_d)
+  !
+  ! bec_d = vkb^H psi   (as calbec_k: sum over the band group)
+  !$acc host_data use_device(vkb, psi, bec_d)
+  CALL MYZGEMM( 'C', 'N', nkb, m, n, (1.0_DP,0.0_DP), vkb, lda, psi, lda, &
+                (0.0_DP,0.0_DP), bec_d, nkb )
+  !$acc end host_data
+  IF ( mp_size(intra_bgrp_comm) > 1 ) THEN
+     !$acc host_data use_device(bec_d)
+     CALL mp_sum( bec_d, intra_bgrp_comm )
+     !$acc end host_data
+  END IF
+  !
+  ! ps_d = BB_ bec_d
+  !$acc host_data use_device(BB_, bec_d, ps_d)
+  CALL MYZGEMM( 'N', 'N', nkb, m, nkb, (1.0_DP,0.0_DP), BB_, nkb, bec_d, nkb, &
+                (0.0_DP,0.0_DP), ps_d, nkb )
+  !$acc end host_data
+  !
+  ! spsi = spsi + vkb ps_d
+  !$acc host_data use_device(vkb, ps_d, spsi)
+  CALL MYZGEMM( 'N', 'N', n, m, nkb, (1.0_DP,0.0_DP), vkb, lda, ps_d, nkb, &
+                (1.0_DP,0.0_DP), spsi, lda )
+  !$acc end host_data
+  !
+  !$acc end data
+  DEALLOCATE( bec_d, ps_d )
+  !
+  CALL stop_clock( 'sm1' )
+  !
+END SUBROUTINE sm1_psi_acc
+#endif

diff --git a/XSpectra/src/lanczos_acc.f90 b/XSpectra/src/lanczos_acc.f90
new file mode 100644
index 000000000..7d7b8c120
--- /dev/null
+++ b/XSpectra/src/lanczos_acc.f90
@@ -0,0 +1,338 @@
+!
+! Copyright (C) 2026 Quantum ESPRESSO group
+! This file is distributed under the terms of the
+! GNU General Public License. See the file `License'
+! in the root directory of the present distribution,
+! or http://www.gnu.org/copyleft/gpl.txt .
+!
+!------------------------------------------------------------------------------
+! GPU (OpenACC) versions of lanczos and lanczos_uspp (lanczos.f90).
+! The Lanczos vectors stay on the device for the whole recursion; h_psi,
+! S^-1 (sm1_psi_acc) and the vector algebra run there, and only the scalars
+! a(i), b(i) come back to the host, where the convergence test (converge /
+! continued_fraction) is unchanged. Same recursion, same order of operations
+! as the host routines; only the summation order of the dot products differs.
+! Compiled only in the GPU build; lanczos/lanczos_uspp dispatch here.
+!------------------------------------------------------------------------------
+#if defined(__CUDA)
+!------------------------------------------------------------------------------
+SUBROUTINE xs_check_gpu_support()
+  !----------------------------------------------------------------------------
+  !! The device path assumes a collinear k-point calculation (becp%k, one
+  !! npwx-long vector): stop explicitly otherwise.
+  USE control_flags,    ONLY : gamma_only
+  USE noncollin_module, ONLY : noncolin
+  IMPLICIT NONE
+  IF (gamma_only) CALL errore('xspectra', &
+       'gamma_only is not supported by the GPU version of XSpectra', 1)
+  IF (noncolin) CALL errore('xspectra', &
+       'noncollinear calculations are not supported by the GPU version of XSpectra', 1)
+END SUBROUTINE xs_check_gpu_support
+!
+!------------------------------------------------------------------------------
+FUNCTION xs_rdot_acc( n, x, y ) RESULT( s )
+  !----------------------------------------------------------------------------
+  !! Re <x|y> over the first n components (= ddot(2n,x,1,y,1)); x, y on device
+  USE kinds, ONLY : DP
+  IMPLICIT NONE
+  INTEGER,     INTENT(IN) :: n
+  COMPLEX(DP), INTENT(IN) :: x(n), y(n)
+  REAL(DP) :: s
+  INTEGER  :: j
+  s = 0.0_DP
+  !$acc parallel loop reduction(+:s) present(x, y)
+  DO j = 1, n
+     s = s + DBLE(x(j))*DBLE(y(j)) + AIMAG(x(j))*AIMAG(y(j))
+  END DO
+END FUNCTION xs_rdot_acc
+!
+!------------------------------------------------------------------------------
+SUBROUTINE lanczos_uspp_acc( a, b, npw, psi, ncalcv, terminator )
+  !----------------------------------------------------------------------------
+  USE kinds,     ONLY: DP
+  USE wvfct,     ONLY: npwx
+  USE becmod,    ONLY: becp
+  USE constants, ONLY: rytoev
+  USE xspectra,  ONLY: xniter, xnepoint, xcheck_conv, xnitermax, &
+                       xemin, xemax, xgamma, xerror
+  USE mp_pools,  ONLY: intra_pool_comm
+  USE mp,        ONLY: mp_sum
+  USE io_global, ONLY: stdout
+  !
+  IMPLICIT NONE
+  !
+  REAL(dp),    INTENT(INOUT) :: a(xnitermax), b(xnitermax)
+  COMPLEX(dp), INTENT(INOUT) :: psi(npwx)
+  INTEGER,     INTENT(INOUT) :: ncalcv
+  INTEGER,     INTENT(IN)    :: npw
+  LOGICAL,     INTENT(IN)    :: terminator
+  !
+  LOGICAL  :: converge, iconv, recalc
+  INTEGER  :: i, j
+  REAL(dp) :: error, xemin_ry, xemax_ry, xgamma_ry, ai, bim1, rb
+  REAL(dp), ALLOCATABLE :: comp(:)
+  COMPLEX(dp), ALLOCATABLE :: u(:), v1(:), v2(:)
+  REAL(dp), EXTERNAL :: xs_rdot_acc
+  EXTERNAL :: h_psi
+  !
+  ALLOCATE( v1(npwx), v2(npwx), u(npwx), comp(xnepoint) )
+  a(:) = 0.d0
+  b(:) = 0.d0
+  xemax_ry  = xemax/rytoev
+  xemin_ry  = xemin/rytoev
+  xgamma_ry = xgamma/rytoev
+  iconv = .false.
+  !
+  CALL xs_check_gpu_support()
+  ! becp is allocated on the host by the caller: mirror it on the device
+  !$acc enter data copyin(becp)
+  !$acc enter data copyin(becp%k)
+  !$acc data copy(psi) create(u, v1, v2)
+  !
+  !$acc parallel loop present(u, v1, v2)
+  DO j = 1, npwx
+     u(j)  = (0.d0,0.d0)
+     v1(j) = (0.d0,0.d0)
+     v2(j) = (0.d0,0.d0)
+  END DO
+  !
+  ! ------------------------  1st iteration --------------------------
+  !
+  recalc = .true.
+  CALL sm1_psi_acc( recalc, npwx, npw, 1, psi, v1 )  ! v1 = S^-1 psi
+  CALL h_psi( npwx, npw, 1, v1, u )                  ! u  = H v1
+  !
+  a(1) = xs_rdot_acc( npw, v1, u )                   ! a_1 = <v1|u>
+  CALL mp_sum( a(1), intra_pool_comm )
+  ai = a(1)
+  !$acc parallel loop present(u, psi)
+  DO j = 1, npw
+     u(j) = u(j) - ai*psi(j)                         ! u = u - a_1 psi
+  END DO
+  recalc = .false.
+  CALL sm1_psi_acc( recalc, npwx, npw, 1, u, v1 )    ! v1 = S^-1 u
+  !
+  b(1) = xs_rdot_acc( npw, u, v1 )                   ! b_1 = sqrt(<u|v1>)
+  CALL mp_sum( b(1), intra_pool_comm )
+  b(1) = SQRT( b(1) )
+  rb = 1.d0/b(1)
+  !$acc parallel loop present(u, v1)
+  DO j = 1, npw
+     u(j)  = u(j)*rb
+     v1(j) = v1(j)*rb
+  END DO
+  !
+  ! -------------------------- Next iterations -----------------------
+  !
+  comp(:) = 0.d0
+  comp(1) = 1.d0
+  !
+  DO i = 2, xniter
+     !
+     CALL h_psi( npwx, npw, 1, v1, v2 )              ! v2 = H v1
+     !
+     a(i) = xs_rdot_acc( npw, v1, v2 )               ! a_i = <v1|v2>
+     CALL mp_sum( a(i), intra_pool_comm )
+     !
+     ai = a(i)
+     bim1 = b(i-1)
+     !$acc parallel loop present(v2, psi, u)
+     DO j = 1, npw
+        v2(j) = v2(j) - bim1*psi(j)                  ! v2 = v2 - b_{i-1} psi
+        v2(j) = v2(j) - ai*u(j)                      ! v2 = v2 - a_i u
+     END DO
+     !
+     !$acc parallel loop present(v1)
+     DO j = 1, npwx
+        v1(j) = (0.d0,0.d0)
+     END DO
+     recalc = .false.
+     CALL sm1_psi_acc( recalc, npwx, npw, 1, v2, v1 ) ! v1 = S^-1 v2
+     !
+     b(i) = xs_rdot_acc( npw, v2, v1 )               ! b_i = sqrt(<v2|v1>)
+     CALL mp_sum( b(i), intra_pool_comm )
+     b(i) = SQRT( b(i) )
+     !
+     rb = 1.d0/b(i)
+     !$acc parallel loop present(psi, u, v1, v2)
+     DO j = 1, npwx
+        psi(j) = u(j)                                ! psi <- u
+        IF (j <= npw) THEN
+           v2(j) = v2(j)*rb                          ! v2 = v2/b_i
+           v1(j) = v1(j)*rb                          ! v1 = v1/b_i
+        END IF
+        u(j) = v2(j)                                 ! u <- v2
+     END DO
+     !
+     IF (MOD(i,xcheck_conv) == 0) THEN
+        IF (converge(a, b, i, comp, error, xemin_ry, xemax_ry, &
+                     xgamma_ry, xnepoint, xerror, terminator)) THEN
+           WRITE(stdout,'(8x,a,i6,a,f12.8)') '!   => CONVERGED at iter ',i,&
+                                             ' with error=',error
+           ncalcv = i
+           iconv = .true.
+           EXIT
+        ELSE
+           WRITE(stdout,'(8x,a,i6,a,f12.8)') '|   Estimated error at iter ',i,&
+                                             ': ', error
+        ENDIF
+     ENDIF
+     !
+  ENDDO
+  !
+  !$acc end data
+  !$acc exit data delete(becp%k)
+  !$acc exit data delete(becp)
+  !
+  IF (.NOT.iconv) THEN
+     WRITE(stdout,'(8x,a,i6,a)') '!   XANES not converged after', i-1,&
+                                 ' iterations'
+     WRITE(stdout,'(8x,a,i6,a,l1)') '!   Estimated final error after ',&
+          i-1,'iterations: ', &
+          converge(a,b,i-1,comp,error,xemin_ry,xemax_ry,&
+                   xgamma_ry,xnepoint,xerror,terminator)
+     ncalcv = i-1
+  ENDIF
+  !
+  DEALLOCATE( v1, v2, u, comp )
+  !
+END SUBROUTINE lanczos_uspp_acc
+!
+!------------------------------------------------------------------------------
+SUBROUTINE lanczos_acc( a, b, npw, psi, ncalcv, terminator )
+  !----------------------------------------------------------------------------
+  !! norm-conserving case (S = 1)
+  USE kinds,     ONLY: DP
+  USE wvfct,     ONLY: npwx
+  USE becmod,    ONLY: becp
+  USE constants, ONLY: rytoev
+  USE xspectra,  ONLY: xniter, xnepoint, xcheck_conv, xnitermax, &
+                       xemin, xemax, xgamma, xerror
+  USE mp_pools,  ONLY: intra_pool_comm
+  USE mp,        ONLY: mp_sum
+  USE io_global, ONLY: stdout
+  !
+  IMPLICIT NONE
+  !
+  REAL(dp),    INTENT(INOUT) :: a(xnitermax), b(xnitermax)
+  COMPLEX(dp), INTENT(INOUT) :: psi(npwx)
+  INTEGER,     INTENT(INOUT) :: ncalcv
+  INTEGER,     INTENT(IN)    :: npw
+  LOGICAL,     INTENT(IN)    :: terminator
+  !
+  LOGICAL  :: converge, iconv, ldummy
+  INTEGER  :: i, j
+  REAL(dp) :: error, xemin_ry, xemax_ry, xgamma_ry, ai, bim1, rb
+  REAL(dp), ALLOCATABLE :: comp(:)
+  COMPLEX(dp), ALLOCATABLE :: hpsi(:), u(:)
+  REAL(dp), EXTERNAL :: xs_rdot_acc
+  EXTERNAL :: h_psi
+  !
+  ALLOCATE( hpsi(npwx), u(npwx), comp(xnepoint) )
+  a(:) = 0.d0
+  b(:) = 0.d0
+  xemax_ry  = xemax/rytoev
+  xemin_ry  = xemin/rytoev
+  xgamma_ry = xgamma/rytoev
+  iconv = .false.
+  !
+  CALL xs_check_gpu_support()
+  !$acc enter data copyin(becp)
+  !$acc enter data copyin(becp%k)
+  !$acc data copy(psi) create(hpsi, u)
+  !
+  !$acc parallel loop present(hpsi, u)
+  DO j = 1, npwx
+     hpsi(j) = (0.d0,0.d0)
+     u(j)    = (0.d0,0.d0)
+  END DO
+  !
+  ! ------------------------  1st iteration --------------------------
+  !
+  CALL h_psi( npwx, npw, 1, psi, hpsi )              ! hpsi = H psi
+  a(1) = xs_rdot_acc( npw, psi, hpsi )               ! a_1 = <psi|H psi>
+  CALL mp_sum( a(1), intra_pool_comm )
+  ai = a(1)
+  !$acc parallel loop present(hpsi, psi)
+  DO j = 1, npw
+     hpsi(j) = hpsi(j) - ai*psi(j)
+  END DO
+  b(1) = xs_rdot_acc( npw, hpsi, hpsi )
+  CALL mp_sum( b(1), intra_pool_comm )
+  b(1) = SQRT( b(1) )
+  rb = 1.d0/b(1)
+  !$acc parallel loop present(hpsi, u)
+  DO j = 1, npwx
+     IF (j <= npw) THEN
+        hpsi(j) = hpsi(j)*rb
+        u(j) = hpsi(j)                               ! |u1>
+     END IF
+     hpsi(j) = (0.d0,0.d0)
+  END DO
+  !
+  ! -------------------------- Next iterations -----------------------
+  !
+  comp(:) = 0.d0
+  comp(1) = 1.d0
+  !
+  DO i = 2, xniter
+     !   u = psi_j, hpsi = empty, psi = psi_j-1
+     CALL h_psi( npwx, npw, 1, u, hpsi )
+     !
+     bim1 = b(i-1)
+     !$acc parallel loop present(hpsi, psi)
+     DO j = 1, npw
+        hpsi(j) = hpsi(j) - bim1*psi(j)
+     END DO
+     a(i) = xs_rdot_acc( npw, hpsi, u )
+     CALL mp_sum( a(i), intra_pool_comm )
+     ai = a(i)
+     !$acc parallel loop present(hpsi, u)
+     DO j = 1, npw
+        hpsi(j) = hpsi(j) - ai*u(j)
+     END DO
+     b(i) = xs_rdot_acc( npw, hpsi, hpsi )
+     CALL mp_sum( b(i), intra_pool_comm )
+     b(i) = SQRT( b(i) )
+     rb = 1.d0/b(i)
+     !$acc parallel loop present(psi, u, hpsi)
+     DO j = 1, npw
+        psi(j)  = u(j)
+        u(j)    = hpsi(j)*rb
+        hpsi(j) = (0.d0,0.d0)
+     END DO
+     !
+     IF (MOD(i,xcheck_conv) == 0) THEN
+        IF (converge(a, b, i, comp, error, xemin_ry, xemax_ry, &
+                     xgamma_ry, xnepoint, xerror, terminator)) THEN
+           WRITE(stdout,'(8x,a,i6,a,f12.8)') '!   => CONVERGED at iter ',i,&
+                                             ' with error=',error
+           ncalcv = i
+           iconv = .true.
+           EXIT
+        ELSE
+           WRITE(stdout,'(8x,a,i6,a,f12.8)') '|   Estimated error at iter ',i,&
+                                             ': ', error
+        ENDIF
+     ENDIF
+     !
+  ENDDO
+  !
+  !$acc end data
+  !$acc exit data delete(becp%k)
+  !$acc exit data delete(becp)
+  !
+  IF (.NOT.iconv) THEN
+     ldummy = converge(a,b,i-1,comp,error,xemin_ry,xemax_ry,&
+                       xgamma_ry,xnepoint,xerror,terminator)
+     WRITE(stdout,'(8x,a,i6,a)') '!   XANES not converged after', i-1,&
+                                 ' iterations'
+     WRITE(stdout,'(8x,a,i6,a,f12.8)') '!   Estimated final error after ',&
+          i-1,'iterations: ', error
+     ncalcv = i-1
+  ENDIF
+  !
+  DEALLOCATE( hpsi, u, comp )
+  !
+END SUBROUTINE lanczos_acc
+#endif

From b071026389d56656c21045fa0be918fdd6b517de Mon Sep 17 00:00:00 2001
From: ynwang <ynwang@iis.u-tokyo.ac.jp>
Date: Wed, 11 Nov 2026 14:29:03 +0900
Subject: [PATCH 5/9] XSpectra GPU: stop on the norm-conserving Lanczos path

Only lanczos_uspp (US/PAW, S^-1) has been validated on the GPU; the
norm-conserving lanczos now calls errore in the GPU build instead of
running unvalidated code, and lanczos_acc is removed (it remains in
4ae25d92e). CPU build unchanged.
---
 XSpectra/src/lanczos.f90     |   7 +-
 XSpectra/src/lanczos_acc.f90 | 143 +----------------------------------
 2 files changed, 7 insertions(+), 143 deletions(-)

diff --git a/XSpectra/src/lanczos.f90 b/XSpectra/src/lanczos.f90
index a214dc4b9..94d7281b1 100644
--- a/XSpectra/src/lanczos.f90
+++ b/XSpectra/src/lanczos.f90
@@ -45,9 +45,10 @@ SUBROUTINE lanczos (a,b,npw,psi,ncalcv,terminator)
 
 
 #if defined(__CUDA)
-  ! GPU build: device-resident recursion (lanczos_acc.f90)
-  CALL lanczos_acc(a,b,npw,psi,ncalcv,terminator)
-  RETURN
+  ! GPU build: only the ultrasoft/PAW recursion (lanczos_uspp_acc) has been
+  ! ported and validated; stop instead of giving unvalidated results.
+  CALL errore('lanczos', 'norm-conserving pseudopotentials (no S matrix) &
+       &are not supported by the GPU version of XSpectra', 1)
 #endif
 
   ALLOCATE(hpsi(npwx))
diff --git a/XSpectra/src/lanczos_acc.f90 b/XSpectra/src/lanczos_acc.f90
index 7d7b8c120..76ec90757 100644
--- a/XSpectra/src/lanczos_acc.f90
+++ b/XSpectra/src/lanczos_acc.f90
@@ -6,13 +6,14 @@
 ! or http://www.gnu.org/copyleft/gpl.txt .
 !
 !------------------------------------------------------------------------------
-! GPU (OpenACC) versions of lanczos and lanczos_uspp (lanczos.f90).
+! GPU (OpenACC) version of lanczos_uspp (lanczos.f90). The norm-conserving
+! lanczos has no GPU version: it stops with an error in the GPU build.
 ! The Lanczos vectors stay on the device for the whole recursion; h_psi,
 ! S^-1 (sm1_psi_acc) and the vector algebra run there, and only the scalars
 ! a(i), b(i) come back to the host, where the convergence test (converge /
 ! continued_fraction) is unchanged. Same recursion, same order of operations
 ! as the host routines; only the summation order of the dot products differs.
-! Compiled only in the GPU build; lanczos/lanczos_uspp dispatch here.
+! Compiled only in the GPU build; lanczos_uspp dispatches here.
 !------------------------------------------------------------------------------
 #if defined(__CUDA)
 !------------------------------------------------------------------------------
@@ -197,142 +198,4 @@ SUBROUTINE lanczos_uspp_acc( a, b, npw, psi, ncalcv, terminator )
   DEALLOCATE( v1, v2, u, comp )
   !
 END SUBROUTINE lanczos_uspp_acc
-!
